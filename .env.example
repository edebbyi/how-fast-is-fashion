# LLM (trend mapper + normalization)
GEMINI_API_KEY=...

# Langfuse (LLM observability)
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...
LANGFUSE_HOST="https://us.cloud.langfuse.com"
LANGFUSE_PROMPT_NORMALIZATION="fashion-forensics/normalization"

# MLflow (experiment tracking)
# Start server with: uvx mlflow server (runs on port 5000)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fashion-forensics

# Trend curation review app (client-side; read directly by review_app.py)
# Start the backend with: uvicorn fashion_forensics.curation.api:app --port 8010
CURATION_API_BASE_URL=http://localhost:8010
